PORT=5000
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ---------------------------------------------------------------------------
# System 1 — Jev (TypeSafe). Real decision model, called via OpenRouter's
# Decisions API. $0.042 per 1M input tokens, output tokens are free.
# Model page: https://openrouter.ai/typesafe
# Docs:       https://openrouter.ai/docs/guides/features/decisions
# ---------------------------------------------------------------------------
JEV_MODEL=typesafe/jev-1.14
JEV_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# System 2 — Inkling (Thinking Machines Lab). Comma separated; the first model
# that answers is used. Order is cheapest-first.
#   inkling-2-mini  $0.10 / $0.40 per 1M   (1.05M ctx)
#   inkling-2-small $0.30 / $1.00 per 1M   (1.05M ctx)
#   inkling         $1.00 / $4.05 per 1M   (524k ctx)
# ---------------------------------------------------------------------------
INKLING_MODELS=thinkingmachines/inkling-2-mini,thinkingmachines/inkling-2-small,thinkingmachines/inkling
INKLING_FALLBACK_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Supabase PostgreSQL Database (optional — local JSON file store is used if unset)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
